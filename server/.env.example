# Arbiter Server configuration (copy to server/.env — never commit the real .env)

# Where the proxy listens. OpenCode's provider baseUrl points here.
ARBITER_HOST=127.0.0.1
ARBITER_PORT=4317

# Google credentials are borrowed from OpenCode's auth.json automatically.
# GOOGLE_API_KEY=
# GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OLLAMA_BASE_URL=http://localhost:11434   # no /v1 suffix — client path already includes it

# Credential precedence: process env > this .env > OpenCode's auth.json.
# ARBITER_READ_OPENCODE_AUTH=1                 # set 0 to ignore OpenCode's store
# OPENCODE_AUTH_PATH=/custom/path/auth.json    # override the default location

# Each {PROVIDER}_API_KEY is validated at startup with one real auth call.
# Known providers: anthropic, openai, openrouter, groq, mistral, deepseek, xai, google/gemini.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# Per-provider endpoint override: {PROVIDER}_BASE_URL
# OPENAI_BASE_URL=https://api.openai.com

# Ollama models are discovered at startup and re-polled on this interval (seconds).
# OLLAMA_POLL_INTERVAL=30
# DISCOVERY_TIMEOUT=5          # per-call timeout (seconds) for validation + tag polling
# ARBITER_DISCOVERY=1          # set 0 to skip all startup discovery / network calls
